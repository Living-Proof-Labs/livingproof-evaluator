{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/request.schema.json",
  "title": "Run integrity request payload",
  "description": "One run's manifest, verification lock, and trial evidence. Check-specific artifacts live under evidence, keyed by the check id. The common payload does not list those keys, so a new check can add evidence without a new payload version. Each check schema validates its own evidence object.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["manifest", "lock", "trials"],
  "properties": {
    "manifest": {"$ref": "#/$defs/manifest"},
    "lock": {"$ref": "#/$defs/lock"},
    "trials": {
      "type": "array",
      "items": {"$ref": "#/$defs/trial"}
    },
    "evidence": {
      "type": "object",
      "description": "Optional evidence for individual checks. Each property name is a check id. Evidence cannot carry a robot verdict.",
      "properties": {
        "verdict": false,
        "grade": false,
        "pass": false,
        "fail": false,
        "robot_verdict": false,
        "robot_result": false
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": false,
          "grade": false,
          "pass": false,
          "fail": false,
          "robot_verdict": false,
          "robot_result": false
        }
      }
    },
    "verdict": false,
    "grade": false,
    "pass": false,
    "fail": false
  },
  "$defs": {
    "sha256": {
      "$ref": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/defs.schema.json#/$defs/sha256"
    },
    "pin": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pins": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["specs", "runner", "verifier", "world", "configuration"],
      "properties": {
        "specs": {"$ref": "#/$defs/pin"},
        "runner": {"$ref": "#/$defs/pin"},
        "verifier": {"$ref": "#/$defs/pin"},
        "world": {"$ref": "#/$defs/pin"},
        "configuration": {"$ref": "#/$defs/pin"}
      }
    },
    "manifest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["id", "deterministic", "pins", "planned_trials"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "deterministic": {
          "type": "boolean",
          "description": "The run plan repeated the same inputs. The agreement check reads robot_determinism, not this flag."
        },
        "robot_determinism": {
          "enum": ["deterministic", "non-deterministic"],
          "description": "Declaration of the robot software. Omitted on a simulation means deterministic, so a recording mismatch is investigated as a test-system finding."
        },
        "environment": {
          "enum": ["simulation", "hardware"],
          "description": "Omitted means simulation, which is the default for the published MuJoCo runs."
        },
        "pins": {"$ref": "#/$defs/pins"},
        "planned_trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "lock": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["pins"],
      "properties": {
        "pins": {"$ref": "#/$defs/pins"}
      }
    },
    "recording": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["present", "missing", "truncated", "empty"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"enum": ["present", "truncated"]}},
            "required": ["state"]
          },
          "then": {"required": ["sha256"]}
        },
        {
          "if": {
            "properties": {"state": {"enum": ["missing", "empty"]}},
            "required": ["state"]
          },
          "then": {"properties": {"sha256": false}}
        }
      ]
    },
    "observations": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["present", "missing", "truncated", "empty"]}
      }
    },
    "trial": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["id", "input_sha256", "recording", "observations", "termination"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Identity of the trial input. Same-input agreement groups trials by this hash."
        },
        "recording": {"$ref": "#/$defs/recording"},
        "observations": {"$ref": "#/$defs/observations"},
        "termination": {
          "enum": ["completed", "timeout", "crash"],
          "description": "completed means the trial ended on its own. timeout and crash mean it did not."
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque outcome string. Integrity compares it for equality and does not grade it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"termination": {"const": "completed"}},
            "required": ["termination"]
          },
          "then": {"required": ["outcome"]}
        },
        {
          "if": {
            "properties": {"termination": {"enum": ["timeout", "crash"]}},
            "required": ["termination"]
          },
          "then": {"properties": {"outcome": false}}
        }
      ]
    }
  }
}
