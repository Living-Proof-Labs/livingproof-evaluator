{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "same-input-agreement 1.0.0",
  "description": "Trials that share an input hash are compared. Identical recordings with different outcomes are outcome-disagreement, a test-system finding from the grader. Different recordings are recording-mismatch, a test-system finding, when robot_determinism is deterministic or omitted on a simulation. Different recordings are robot-variation when robot_determinism is non-deterministic: the check stays successful, percentage stays 100, and the finding reports the variation.",
  "allOf": [
    {
      "$ref": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/result.schema.json#/$defs/check"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "id": {"const": "same-input-agreement"},
    "version": {"const": "1.0.0"},
    "findings": {
      "items": {
        "required": ["trial_ids"],
        "properties": {
          "category": {
            "enum": ["recording-mismatch", "outcome-disagreement", "robot-variation"]
          },
          "trial_id": false,
          "subject": false,
          "check_run": false
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {"enum": ["recording-mismatch", "outcome-disagreement"]}
              },
              "required": ["category"]
            },
            "then": {
              "properties": {"classification": {"const": "test_system"}}
            }
          },
          {
            "if": {
              "properties": {"category": {"const": "robot-variation"}},
              "required": ["category"]
            },
            "then": {
              "properties": {"classification": {"const": "robot_variation"}}
            }
          }
        ]
      }
    }
  }
}
