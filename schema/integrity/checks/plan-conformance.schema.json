{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/checks/plan-conformance.schema.json",
  "title": "plan-conformance 1.0.0",
  "description": "The trials that ran are the trials that were planned. The plan trial count, trials.count, the number of trials.results entries, and the lock's plan trial count agree. The plan command_speed matches the lock's. trials.results[].index is exactly 1 to N, with no duplicate, missing, or out-of-range index, and each path is trials/trial-NN.json for its own index. A run whose preconditions are unmet runs no trials, and the check is not applicable. A missing or hash-mismatched trial file stays a completeness finding, so this check reports count and index disagreements only and its findings carry no trial id. When the lock block is absent, the lock comparisons are not made and are not counted. percentage is 100 times the number of subjects without a finding divided by the number of subjects. The subjects are the comparisons that were made, one per index 1 to N, and one per result entry whose index is outside 1 to N. Evidence for this check is evidence['plan-conformance'].",
  "$defs": {
    "plan": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["trial_count"],
      "properties": {
        "trial_count": {"type": "integer", "minimum": 0},
        "command_speed": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["plan", "trials"],
      "properties": {
        "preconditions": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["met"],
          "properties": {
            "met": {
              "type": "boolean",
              "description": "False when the run's preconditions were unmet and it ran no trials. Omitted means met."
            }
          }
        },
        "plan": {"$ref": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/checks/plan-conformance.schema.json#/$defs/plan"},
        "trials": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["count", "results"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "unevaluatedProperties": false,
                "required": ["index", "path"],
                "properties": {
                  "index": {"type": "integer"},
                  "path": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "lock": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": ["plan"],
          "properties": {
            "plan": {"$ref": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/checks/plan-conformance.schema.json#/$defs/plan"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/result.schema.json#/$defs/check"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "id": {"const": "plan-conformance"},
    "version": {"const": "1.0.0"},
    "findings": {
      "items": {
        "properties": {
          "category": {
            "enum": [
              "trial-count-mismatch",
              "command-speed-mismatch",
              "index-missing",
              "index-duplicate",
              "index-out-of-range",
              "path-mismatch"
            ]
          },
          "classification": {"const": "test_system"},
          "trial_id": false,
          "trial_ids": false,
          "subject": false,
          "check_run": false
        }
      }
    }
  }
}
