{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/checks/completeness.schema.json",
  "title": "completeness 1.0.0",
  "description": "Every planned trial has a recording and observations, neither missing, truncated, nor empty, and the trial ended on its own. percentage is 100 times the number of complete planned trials divided by the number of planned trials. A planned trial with no evidence is missing-trial. This check's findings are test-system findings.",
  "allOf": [
    {
      "$ref": "https://github.com/Living-Proof-Labs/livingproof-evaluator/schema/integrity/result.schema.json#/$defs/check"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "id": {"const": "completeness"},
    "version": {"const": "1.0.0"},
    "findings": {
      "items": {
        "required": ["trial_id"],
        "properties": {
          "category": {
            "enum": [
              "missing-trial",
              "missing-recording",
              "missing-observations",
              "truncated-recording",
              "truncated-observations",
              "empty-recording",
              "empty-observations",
              "ended-by-timeout",
              "ended-by-crash"
            ]
          },
          "classification": {"const": "test_system"},
          "subject": false,
          "trial_ids": false,
          "check_run": false
        }
      }
    }
  }
}
